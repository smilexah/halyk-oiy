# Copy to .env and adjust as needed.

# Postgres (shared instance, one database per service)
DATABASE_USERNAME=maqsat
DATABASE_PASSWORD=maqsat
# Host-published port (container always uses 5432 internally). Override if 5432 is taken on your host.
POSTGRES_HOST_PORT=5432

# Keycloak bootstrap admin (master realm)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Service account used by auth-service to call the Keycloak Admin API
KEYCLOAK_ADMIN_CLIENT_SECRET=maqsat-admin-secret

# ai-assistant-service -> Anthropic API
ANTHROPIC_API_KEY=

# Observability (set automatically by the overlay; leave empty for base stack)
# MANAGEMENT_OTLP_TRACING_ENDPOINT=http://tempo:4318/v1/traces