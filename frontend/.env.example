# Frontend env. Copy to `.env.local` and adjust. All vars are build-time (Vite).

# Auth (Keycloak OIDC). Off by default so the app runs without a backend.
# Set to true once Keycloak is up and a public SPA client exists.
VITE_AUTH_ENABLED=false
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=maqsat
VITE_KEYCLOAK_CLIENT_ID=maqsat-web
